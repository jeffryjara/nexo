---
import MainLayout from '../layouts/MainLayout.astro';
import { GlowCard } from '../components/ui/spotlight-card';

---
<MainLayout title="Nexo Plataform">
    
        <div class="absolute top-6 right-6 md:top-8 md:right-8 z-50">
            <button id="theme-toggle" class="p-2.5 rounded-2xl bg-surface border border-border text-text-muted hover:text-text-main transition-colors shadow-sm flex items-center justify-center">
                <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            </button>
        </div>

    <div class="min-h-screen px-6 py-8 md:px-12 max-w-6xl mx-auto flex flex-col justify-between">
        <header class="mt-4 md:mt-8 mb-8 text-center animate-fade-in flex flex-col items-center">
            <h1 class="text-6xl md:text-7xl font-extrabold text-text-main tracking-widest leading-none">NEXO</h1>
            <p class="text-xl md:text-2xl font-light text-text-muted tracking-[0.3em] mt-1">Plataform</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 my-auto w-full">
            <!-- 1. Arquitectura -->
            <a href="/arquitectura" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-2 md:col-span-1">
                <GlowCard client:load customSize={true} glowColor="blue" className="!h-full !flex !flex-col !p-6 !gap-8 !rounded-3xl cursor-pointer">
                <span class="text-accent font-bold text-xs tracking-[0.2em]">Curso</span>
                <h2 class="text-2xl font-extrabold text-white/40 group-hover:text-white transition-colors duration-300">Arquitectura del Computador</h2>
                <div class="inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-text-main group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
                </div>
                </GlowCard>
            </a>

            <!-- 2. Base de Datos -->
            <a href="/bd" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-2 md:col-span-1">
                <GlowCard client:load customSize={true} glowColor="orange" className="!h-full !flex !flex-col !p-6 !gap-8 !rounded-3xl cursor-pointer relative">
                <span class="absolute top-6 right-6 text-white/10 text-xs font-semibold tracking-wider">En proceso</span>
                <span class="text-accent font-bold text-xs tracking-[0.2em]">Curso</span>
                <h2 class="text-2xl font-extrabold text-white/40 group-hover:text-white transition-colors duration-300">Base de Datos Avanzado y Big Data</h2>
                <div class="inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-text-main group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
                </div>
                </GlowCard>
            </a>

            <!-- 3. Computación Gráfica -->
            <a href="/grafica" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-2 md:col-span-1">
                <GlowCard client:load customSize={true} glowColor="purple" className="!h-full !flex !flex-col !p-6 !gap-8 !rounded-3xl cursor-pointer relative">
                <span class="absolute top-6 right-6 text-white/10 text-xs font-semibold tracking-wider">En proceso</span>
                <span class="text-accent font-bold text-xs tracking-[0.2em]">Curso</span>
                <h2 class="text-2xl font-extrabold text-white/40 group-hover:text-white transition-colors duration-300">Computación Gráfica y Visual</h2>
                <div class="inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-text-main group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
                </div>
                </GlowCard>
            </a>

            <!-- 4. Interacción Humano Computador -->
            <a href="/ihc" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-3 md:col-span-1">
                <GlowCard client:load customSize={true} glowColor="green" className="!h-full !flex !flex-col !p-6 !gap-8 !rounded-3xl cursor-pointer relative">
                <span class="absolute top-6 right-6 text-white/10 text-xs font-semibold tracking-wider">En proceso</span>
                <span class="text-accent font-bold text-xs tracking-[0.2em]">Curso</span>
                <h2 class="text-2xl font-extrabold text-white/40 group-hover:text-white transition-colors duration-300">Interacción Humano Computador</h2>
                <div class="inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-text-main group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
                </div>
                </GlowCard>
            </a>

            <!-- 5. Modelamiento y Análisis de Software -->
            <a href="/modelamiento" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-3 md:col-span-2">
                <GlowCard client:load customSize={true} glowColor="red" className="!h-full !flex !flex-col !p-6 !gap-8 !rounded-3xl cursor-pointer relative">
                <span class="absolute top-6 right-6 text-white/10 text-xs font-semibold tracking-wider">En proceso</span>
                <span class="text-accent font-bold text-xs tracking-[0.2em]">Curso</span>
                <h2 class="text-2xl font-extrabold text-white/40 group-hover:text-white transition-colors duration-300">Modelamiento y Análisis de Software</h2>
                <div class="inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-text-main group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
                </div>
                </GlowCard>
            </a></div>

        <footer class="mb-4 mt-8">
            <!-- Firmas de los desarrolladores -->
            <div class="p-8 flex flex-col justify-center items-center text-center bg-transparent border-none">
                <p class="text-text-muted text-sm tracking-widest font-light mb-4">Desarrollado por</p>
                <div id="dev-signatures" class="flex items-center gap-4 justify-center cursor-default transition-transform hover:scale-105 duration-300" style="font-family: 'Caveat', cursive; min-width: 300px;">
                    <span id="dev-1" class="text-4xl text-text-main opacity-90 transform -rotate-2">J3T</span>
                    <span class="text-accent text-2xl opacity-50">&amp;</span>
                    <span id="dev-2" class="text-4xl text-text-main opacity-90 transform rotate-2">JuanHP</span>
                </div>
            </div>
        
        </footer>
    </div>

<script>
    const themeToggleBtn = document.getElementById('theme-toggle');
    const darkIcon = document.getElementById('theme-toggle-dark-icon');
    const lightIcon = document.getElementById('theme-toggle-light-icon');

    // Setup initial icon
    if (document.documentElement.classList.contains('dark')) {
        lightIcon.classList.remove('hidden');
    } else {
        darkIcon.classList.remove('hidden');
    }

    themeToggleBtn.addEventListener('click', function() {
        darkIcon.classList.toggle('hidden');
        lightIcon.classList.toggle('hidden');
        if (document.documentElement.classList.contains('dark')) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('color-theme', 'light');
        } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('color-theme', 'dark');
        }
    });
</script>


<script>
    const dev1 = document.getElementById('dev-1');
    const dev2 = document.getElementById('dev-2');
    const devContainer = document.getElementById('dev-signatures');
    
    if (devContainer && dev1 && dev2) {
        const d1Short = "J3T", d1Long = "Jeffry Jara";
        const d2Short = "JuanHP", d2Long = "Juan Huertas";
        
        let typingInterval1, typingInterval2;
        
        function animateText(element, target, intervalRef) {
            clearInterval(intervalRef);
            let current = element.innerText;
            return setInterval(() => {
                let i = 0;
                while(i < current.length && i < target.length && current[i] === target[i]) i++;
                
                if (current.length > i) {
                    current = current.slice(0, -1);
                } else if (current.length < target.length) {
                    current = target.slice(0, current.length + 1);
                } else {
                    clearInterval(intervalRef);
                }
                element.innerText = current;
            }, 45); // Typing speed
        }
        
        devContainer.addEventListener('mouseenter', () => {
            typingInterval1 = animateText(dev1, d1Long, typingInterval1);
            typingInterval2 = animateText(dev2, d2Long, typingInterval2);
        });
        
        devContainer.addEventListener('mouseleave', () => {
            typingInterval1 = animateText(dev1, d1Short, typingInterval1);
            typingInterval2 = animateText(dev2, d2Short, typingInterval2);
        });
    }
</script>
</MainLayout>
