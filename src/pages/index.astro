---
import MainLayout from '../layouts/MainLayout.astro';
import { GlowCard } from '../components/ui/spotlight-card';

---
<MainLayout title="Nexo Plataform">
    <div class="min-h-screen px-4 sm:px-8 md:px-12 py-8 max-w-6xl mx-auto flex flex-col justify-between">
        <header class="mt-4 md:mt-8 mb-8 text-center animate-fade-in flex flex-col items-center">
            <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold text-text-main tracking-widest leading-none">NEXO</h1>
            <p class="text-lg sm:text-xl md:text-2xl font-light text-text-muted tracking-[0.3em] mt-2">Plataform</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 my-auto w-full max-w-4xl mx-auto">
            <!-- 1. Arquitectura del Computador -->
            <a href="/arquitectura" class="block h-full group transition-all duration-300 md:hover:-translate-y-1">
                <GlowCard client:load customSize={true} tiltLevel="none" glowColor="blue" className="!h-full !flex !flex-col !p-6 sm:!p-8 !gap-6 sm:!gap-8 !rounded-3xl cursor-pointer">
                    <span class="text-accent font-bold text-xs tracking-[0.2em]">Curso</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white/40 md:group-hover:text-white transition-colors duration-300">Arquitectura del Computador</h2>
                    <div class="inline-flex items-center px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm md:group-hover:text-text-main md:group-hover:border-[#a855f7]/60 md:group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max mt-auto">
                        Entrar al laboratorio <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 md:group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
                    </div>
                </GlowCard>
            </a>

            <!-- 2. Base de Datos y Big Data -->
            <a href="/bd" class="block h-full group transition-all duration-300 md:hover:-translate-y-1">
                <GlowCard client:load customSize={true} tiltLevel="none" glowColor="purple" className="!h-full !flex !flex-col !p-6 sm:!p-8 !gap-6 sm:!gap-8 !rounded-3xl cursor-pointer">
                    <span class="text-accent font-bold text-xs tracking-[0.2em]">Curso</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-white/40 md:group-hover:text-white transition-colors duration-300">Base de Datos y Big Data</h2>
                    <div class="inline-flex items-center px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm md:group-hover:text-text-main md:group-hover:border-[#a855f7]/60 md:group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max mt-auto">
                        Entrar al laboratorio <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2 md:group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
                    </div>
                </GlowCard>
            </a>
        </div>

        <footer class="mb-4 mt-8">
            <!-- Firmas de los desarrolladores con animación continua cada 5 segundos -->
            <div class="p-6 flex flex-col justify-center items-center text-center bg-transparent border-none">
                <p class="text-text-muted text-xs sm:text-sm tracking-widest font-light mb-3">Desarrollado por</p>
                <div id="dev-signatures" class="flex items-center gap-4 justify-center cursor-default transition-transform md:hover:scale-105 duration-300" style="font-family: 'Caveat', cursive; min-width: 280px;">
                    <span id="dev-1" class="text-3xl sm:text-4xl text-text-main opacity-90 transform -rotate-2">J3T</span>
                    <span class="text-accent text-2xl opacity-50">&amp;</span>
                    <span id="dev-2" class="text-3xl sm:text-4xl text-text-main opacity-90 transform rotate-2">JuanHP</span>
                </div>
            </div>
        </footer>
    </div>

<script>
    const dev1 = document.getElementById('dev-1');
    const dev2 = document.getElementById('dev-2');
    const devContainer = document.getElementById('dev-signatures');
    
    if (devContainer && dev1 && dev2) {
        const d1Short = "J3T", d1Long = "Jeffry Jara";
        const d2Short = "JuanHP", d2Long = "Juan Huertas";
        
        let typingInterval1, typingInterval2;
        let isLong = false;
        
        function animateText(element, target, intervalRef) {
            clearInterval(intervalRef);
            let current = element.innerText;
            return setInterval(() => {
                let i = 0;
                while(i < current.length && i < target.length && current[i] === target[i]) i++;
                
                if (current.length > i) {
                    current = current.slice(0, -1);
                } else if (current.length < target.length) {
                    current = target.slice(0, current.length + 1);
                } else {
                    clearInterval(intervalRef);
                }
                element.innerText = current;
            }, 45); // Typing speed
        }
        
        function toggleNames() {
            isLong = !isLong;
            typingInterval1 = animateText(dev1, isLong ? d1Long : d1Short, typingInterval1);
            typingInterval2 = animateText(dev2, isLong ? d2Long : d2Short, typingInterval2);
        }

        // Ejecutar animación continua cada 5 segundos
        const loopInterval = setInterval(toggleNames, 5000);
        
        // Soporte adicional interactivo al pasar el cursor en desktop
        devContainer.addEventListener('mouseenter', () => {
            if (!isLong) toggleNames();
        });
        
        devContainer.addEventListener('mouseleave', () => {
            if (isLong) toggleNames();
        });
    }
</script>
</MainLayout>
