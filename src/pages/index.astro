---
import MainLayout from '../layouts/MainLayout.astro';
import { GlowCard } from '../components/ui/spotlight-card';

---
<MainLayout title="Nexo Plataform">
    <div class="min-h-screen px-6 py-8 md:px-12 max-w-6xl mx-auto flex flex-col justify-between">
        <header class="mt-4 md:mt-8 mb-8 text-center animate-fade-in flex flex-col items-center">
            <h1 class="text-6xl md:text-7xl font-extrabold text-white tracking-widest leading-none">NEXO</h1>
            <p class="text-xl md:text-2xl font-light text-white/50 tracking-[0.3em] mt-3 uppercase">Plataform</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 my-auto w-full">
            <!-- 1. Arquitectura -->
            <a href="/arquitectura" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-2 md:col-span-1">
                <GlowCard client:load customSize={true} glowColor="blue" className="!h-full !flex !flex-col !p-6 !gap-0 !rounded-3xl cursor-pointer">
                <div class="bg-accent/20 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-accent-soft group-hover:bg-accent group-hover:text-white transition-all duration-300 group-hover:-translate-y-2 group-hover:scale-110">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent group-hover:text-white"><path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M2 15h10"/><path d="M6 12v6"/></svg>
                </div>
                <h2 class="text-2xl font-extrabold text-white mb-2">Arquitectura del Computador</h2>
                <div class="mt-8 mb-2 inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-white group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio &rarr;
                </div>
                </GlowCard>
            </a>

            <!-- 2. Base de Datos -->
            <a href="/bd" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-2 md:col-span-1">
                <GlowCard client:load customSize={true} glowColor="orange" className="!h-full !flex !flex-col !p-6 !gap-0 !rounded-3xl cursor-pointer relative">
                <div class="absolute top-6 right-6 text-white/10 group-hover:text-white/30 transition-colors">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="bg-white/5 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-accent transition-all duration-300 group-hover:-translate-y-2 group-hover:scale-105">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50 group-hover:text-white"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
                </div>
                <h2 class="text-2xl font-extrabold text-white mb-2">Base de Datos Avanzado y Big Data</h2>
                <div class="mt-8 mb-2 inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-white group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio &rarr;
                </div>
                </GlowCard>
            </a>

            <!-- 3. Computación Gráfica -->
            <a href="/grafica" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-2 md:col-span-1">
                <GlowCard client:load customSize={true} glowColor="purple" className="!h-full !flex !flex-col !p-6 !gap-0 !rounded-3xl cursor-pointer relative">
                <div class="absolute top-6 right-6 text-white/10 group-hover:text-white/30 transition-colors">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="bg-white/5 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-accent transition-all duration-700 group-hover:rotate-180">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50 group-hover:text-white"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                </div>
                <h2 class="text-2xl font-extrabold text-white mb-2">Computación Gráfica y Visual</h2>
                <div class="mt-8 mb-2 inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-white group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio &rarr;
                </div>
                </GlowCard>
            </a>

            <!-- 4. Interacción Humano Computador -->
            <a href="/ihc" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-3 md:col-span-1">
                <GlowCard client:load customSize={true} glowColor="green" className="!h-full !flex !flex-col !p-6 !gap-0 !rounded-3xl cursor-pointer relative">
                <div class="absolute top-6 right-6 text-white/10 group-hover:text-white/30 transition-colors">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="bg-white/5 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-accent transition-all duration-300 group-hover:scale-110">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50 group-hover:text-white"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h2 class="text-2xl font-extrabold text-white mb-2">Interacción Humano Computador</h2>
                <div class="mt-8 mb-2 inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-white group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio &rarr;
                </div>
                </GlowCard>
            </a>

            <!-- 5. Modelamiento y Análisis de Software -->
            <a href="/modelamiento" style="perspective: 1000px;" class="block h-full group transition-transform duration-300 lg:col-span-3 md:col-span-2">
                <GlowCard client:load customSize={true} glowColor="red" className="!h-full !flex !flex-col !p-6 !gap-0 !rounded-3xl cursor-pointer relative">
                <div class="absolute top-6 right-6 text-white/10 group-hover:text-white/30 transition-colors">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="bg-white/5 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-accent transition-all duration-300 group-hover:scale-110 group-hover:-rotate-6">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50 group-hover:text-white"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <h2 class="text-2xl font-extrabold text-white mb-2">Modelamiento y Análisis de Software</h2>
                <div class="mt-8 mb-2 inline-flex items-center px-4 py-2 rounded-xl bg-gradient-to-r from-[#a855f7]/30 to-[#a855f7]/10 backdrop-blur-md border border-[#a855f7]/30 text-[#a855f7] font-semibold text-sm group-hover:text-white group-hover:border-[#a855f7]/60 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300 w-max">
                    Entrar al laboratorio &rarr;
                </div>
                </GlowCard>
            </a></div>

        <footer class="mb-4 mt-8">
            <!-- Firmas de los desarrolladores -->
            <div class="p-8 flex flex-col justify-center items-center text-center bg-transparent border-none">
                <p class="text-text-muted text-sm uppercase tracking-widest font-semibold mb-4">Desarrollado por</p>
                <div class="flex items-center gap-4 justify-center" style="font-family: 'Caveat', cursive;">
                    <span class="text-4xl text-white opacity-90 transform -rotate-2">J3T</span>
                    <span class="text-accent text-2xl opacity-50">&amp;</span>
                    <span class="text-4xl text-white opacity-90 transform rotate-2">JuanHP</span>
                </div>
            </div>
        
        </footer>
    </div>
</MainLayout>