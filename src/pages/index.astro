---
import MainLayout from '../layouts/MainLayout.astro';
import { GlowCard } from '../components/ui/spotlight-card';

---
<MainLayout title="Nexo - Plataforma de Estudio">
    <div class="min-h-screen px-6 py-12 md:px-12 max-w-6xl mx-auto">
        <header class="mb-16 text-center animate-fade-in">
            <h1 class="text-6xl md:text-7xl font-extrabold bg-clip-text text-transparent bg-gradient-to-b from-white to-neutral-500 tracking-tight mb-4 pb-2">Nexo</h1>
            <p class="text-lg text-text-muted">Selecciona un curso para continuar practicando.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Curso 1 -->
            <a href="/arquitectura" class="block h-full group hover:-translate-y-2 transition-transform duration-300">
                <GlowCard client:load customSize={true} glowColor="blue" className="!h-full !flex !flex-col !p-8 !gap-0 !rounded-3xl cursor-pointer">
                <div class="bg-accent/20 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-accent-soft group-hover:bg-accent group-hover:text-white transition-colors">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent group-hover:text-white"><path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M2 15h10"/><path d="M6 12v6"/></svg>
                </div>
                <h2 class="text-xl font-bold text-white mb-2">Arquitectura del Computador</h2>
                <p class="text-sm text-text-muted flex-grow">Práctica de sistemas digitales, álgebra de Boole y mapas de Karnaugh.</p>
                <div class="mt-6 flex items-center text-accent font-semibold text-sm group-hover:text-white transition-colors">
                    Entrar al laboratorio &rarr;
                </div>
                </GlowCard>
            </a>

            <!-- Curso 2 -->
            <a href="/grafica" class="block h-full group hover:-translate-y-2 transition-transform duration-300">
                <GlowCard client:load customSize={true} glowColor="purple" className="!h-full !flex !flex-col !p-8 !gap-0 !rounded-3xl cursor-pointer">
                <div class="bg-white/5 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-accent transition-colors">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50 group-hover:text-white"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                </div>
                <h2 class="text-xl font-bold text-white mb-2">Computación Gráfica y Visual</h2>
                <p class="text-sm text-text-muted flex-grow">Renderizado, matrices de transformación y procesamiento de imágenes.</p>
                </GlowCard>
            </a>

            <!-- Curso 3 -->
            <a href="/ihc" class="block h-full group hover:-translate-y-2 transition-transform duration-300">
                <GlowCard client:load customSize={true} glowColor="green" className="!h-full !flex !flex-col !p-8 !gap-0 !rounded-3xl cursor-pointer">
                <div class="bg-white/5 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-accent transition-colors">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50 group-hover:text-white"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h2 class="text-xl font-bold text-white mb-2">Interacción Humano Computador</h2>
                <p class="text-sm text-text-muted flex-grow">Diseño de interfaces, experiencia de usuario y evaluación heurística.</p>
                </GlowCard>
            </a>

            <!-- Curso 4 -->
            <a href="/bd" class="block h-full group hover:-translate-y-2 transition-transform duration-300">
                <GlowCard client:load customSize={true} glowColor="orange" className="!h-full !flex !flex-col !p-8 !gap-0 !rounded-3xl cursor-pointer">
                <div class="bg-white/5 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-accent transition-colors">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50 group-hover:text-white"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
                </div>
                <h2 class="text-xl font-bold text-white mb-2">Base de Datos Avanzado y Big Data</h2>
                <p class="text-sm text-text-muted flex-grow">Bases de datos no relacionales, data warehousing y procesamiento distribuido.</p>
                </GlowCard>
            </a>

            <!-- Curso 5 -->
            <a href="/modelamiento" class="block h-full group hover:-translate-y-2 transition-transform duration-300">
                <GlowCard client:load customSize={true} glowColor="red" className="!h-full !flex !flex-col !p-8 !gap-0 !rounded-3xl cursor-pointer">
                <div class="bg-white/5 w-12 h-12 rounded-xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-accent transition-colors">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/50 group-hover:text-white"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <h2 class="text-xl font-bold text-white mb-2">Modelamiento y Análisis de Software</h2>
                <p class="text-sm text-text-muted flex-grow">Arquitectura de software, patrones de diseño y diagramas UML.</p>
                </GlowCard>
            </a>
        </div>

        <footer class="mt-24 mb-8">
            <!-- Firmas de los desarrolladores -->
            <div class="glass-panel p-8 rounded-3xl border border-white/5 flex flex-col justify-center items-center text-center " style="background-color: transparent; border-style: dashed;">
                <p class="text-text-muted text-sm uppercase tracking-widest font-semibold mb-4">Desarrollado por</p>
                <div class="flex items-center gap-4 justify-center" style="font-family: 'Caveat', cursive;">
                    <span class="text-4xl text-white opacity-90 transform -rotate-2">J3T</span>
                    <span class="text-accent text-2xl opacity-50">&amp;</span>
                    <span class="text-4xl text-white opacity-90 transform rotate-2">JuanHP</span>
                </div>
            </div>
        
        </footer>
    </div>
</MainLayout>