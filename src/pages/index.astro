---
import MainLayout from '../layouts/MainLayout.astro';
import { GlowCard } from '../components/ui/spotlight-card';
import InteractiveTravelCardDemo from '../components/demo';

---
<MainLayout title="Nexo - Plataforma de Estudio">
    <div class="min-h-screen px-6 py-8 md:px-12 max-w-6xl mx-auto flex flex-col justify-between">
        <header class="mt-4 md:mt-8 mb-4 text-center animate-fade-in">
            <h1 class="text-6xl md:text-7xl font-extrabold bg-clip-text text-transparent bg-gradient-to-b from-white via-neutral-500 to-black tracking-tight mb-2 pb-2">Nexo</h1>
        </header>

        <InteractiveTravelCardDemo client:load />

        <footer class="mb-4 mt-8">
            <!-- Firmas de los desarrolladores -->
            <div class="glass-panel p-8 rounded-3xl border border-white/5 flex flex-col justify-center items-center text-center " style="background-color: transparent; border-style: dashed; backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);">
                <p class="text-text-muted text-sm uppercase tracking-widest font-semibold mb-4">Desarrollado por</p>
                <div class="flex items-center gap-4 justify-center" style="font-family: 'Caveat', cursive;">
                    <span class="text-4xl text-white opacity-90 transform -rotate-2">J3T</span>
                    <span class="text-accent text-2xl opacity-50">&amp;</span>
                    <span class="text-4xl text-white opacity-90 transform rotate-2">JuanHP</span>
                </div>
            </div>
        
        </footer>
    </div>
</MainLayout>