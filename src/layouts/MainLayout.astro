---
import '../styles/global.css';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" class="dark overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Tell browsers and extensions (like Dark Reader) to NOT invert colors -->
    <meta name="color-scheme" content="dark">
    <meta name="darkreader-lock">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script is:inline>
        document.documentElement.classList.add('dark');
    </script>
    <title>{title || 'Plataforma de Estudio'}</title>
</head>
<body class="overflow-x-hidden antialiased relative touch-smooth" style="overscroll-behavior-y: contain;">
    <div id="global-spotlight" class="pointer-events-none fixed inset-0 z-[-50] transition-opacity duration-300 opacity-0 hidden md:block" style="background: radial-gradient(600px circle at 0px 0px, rgba(168,85,247,0.12), transparent 40%);"></div>
    <script>
        // Only run desktop cursor spotlight on devices with fine pointer (mouse/trackpad)
        // Completely disabled on mobile/touch screens to ensure 60fps native performance
        if (window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            let rafId = null;
            let lastX = 0, lastY = 0;
            const spotlight = document.getElementById('global-spotlight');

            const updateSpotlight = () => {
                if (spotlight) {
                    spotlight.style.background = `radial-gradient(600px circle at ${lastX}px ${lastY}px, rgba(168,85,247,0.12), transparent 40%)`;
                    spotlight.style.opacity = '1';
                }
                rafId = null;
            };

            document.addEventListener('mousemove', (e) => {
                lastX = e.clientX;
                lastY = e.clientY;
                if (!rafId) {
                    rafId = requestAnimationFrame(updateSpotlight);
                }
            }, { passive: true });

            document.addEventListener('mouseleave', () => {
                if (spotlight) spotlight.style.opacity = '0';
            }, { passive: true });
        }
    </script>
    <div class="relative z-10 flex flex-col min-h-screen"><slot /></div>
</body>
</html>
