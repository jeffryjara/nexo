---
import '../styles/global.css';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Tell browsers and extensions (like Dark Reader) to NOT invert colors -->
    <meta name="color-scheme" content="dark">
    <meta name="darkreader-lock">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title || 'Plataforma de Estudio'}</title>
</head>
<body class="overflow-x-hidden antialiased">
    <slot />
</body>
</html>
